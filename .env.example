# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

DATABASE_URL=postgres://vrf_user:MESMA_SENHA_DO_DB_PASSWORD@db:5432/vrf_db
DB_PASSWORD=defina-uma-senha-forte-para-o-banco

JWT_SECRET=defina-uma-string-aleatoria-bem-longa
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-antes-de-usar-em-producao
ADMIN_EMAIL=admin@vilarealfutsal.com

# Domínio público final do site (usado nos links de e-mail de redefinição de senha)
APP_URL=https://vilarealfutsal.com.br

# MinIO (armazenamento das fotos)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=defina-um-usuario-de-acesso
MINIO_SECRET_KEY=defina-uma-senha-forte-para-o-minio
# Subdomínio que você vai cadastrar no Nginx Proxy Manager apontando pro MinIO,
# para que as URLs das fotos funcionem publicamente (ex: fotos.vilarealfutsal.com.br)
MINIO_PUBLIC_URL=https://fotos.vilarealfutsal.com.br

# Envio de e-mail (opcional, para recuperação de senha) — deixe em branco se não usar
RESEND_API_KEY=
RESEND_FROM=Vila Real Futsal <onboarding@resend.dev>
